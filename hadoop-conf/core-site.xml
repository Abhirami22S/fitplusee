<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<!-- FitPulse single-node HDFS (development / demo). Hadoop 3.4.1 on Windows, JDK 17. -->
<configuration>
  <property>
    <name>fs.defaultFS</name>
    <value>hdfs://localhost:9000</value>
  </property>
  <property>
    <name>hadoop.tmp.dir</name>
    <value>D:/bigdata/fitpulsee/tools/hdfs-data/tmp</value>
  </property>
</configuration>

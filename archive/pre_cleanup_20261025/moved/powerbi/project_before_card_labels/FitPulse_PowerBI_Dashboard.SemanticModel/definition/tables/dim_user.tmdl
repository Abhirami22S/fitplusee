/// One row per USER (437): age group, gender, days logged, average steps and calories.
table dim_user
	lineageTag: 2f92c427-e769-55b1-8c46-1d5d3127e24b

	column user_id
		dataType: int64
		lineageTag: 4bc17c08-b5c3-5829-9f6f-30e859fc6375
		summarizeBy: none
		sourceColumn: user_id

	column age
		dataType: int64
		lineageTag: 664d33b7-d2b6-5d09-992a-500b55149661
		summarizeBy: none
		sourceColumn: age

	column age_group
		dataType: string
		lineageTag: d5036084-293d-5898-b2f4-2b4a60aa226e
		summarizeBy: none
		sourceColumn: age_group

	column gender
		dataType: string
		lineageTag: adb8bbc4-ed96-598b-bf6e-054acbee29d5
		summarizeBy: none
		sourceColumn: gender

	column days
		dataType: int64
		lineageTag: 754cfaf8-e72d-5e1f-8044-44a80c3031d1
		summarizeBy: none
		sourceColumn: days

	column avg_steps
		dataType: double
		lineageTag: f4adfbf7-f6c6-53b2-9938-af6ea74e4886
		summarizeBy: none
		sourceColumn: avg_steps

	column avg_calories
		dataType: double
		lineageTag: bc8a44cb-3019-51a3-8297-14436d7688ac
		summarizeBy: none
		sourceColumn: avg_calories

	partition dim_user = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "dim_user.csv"), [Delimiter = ",", Columns = 7, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
					Typed = Table.TransformColumnTypes(Headers, {{"user_id", Int64.Type}, {"age", Int64.Type}, {"age_group", type text}, {"gender", type text}, {"days", Int64.Type}, {"avg_steps", type number}, {"avg_calories", type number}}, "en-US")
				in
					Typed

// FitPulse Power BI measures (GENERATED by powerbi/build_powerbi.py from powerbi/model_definition.py - edit that file, not this one).
// They are already inside the generated project's semantic model; this file is the human-readable copy for the report and viva.
// Granularity: fact_daily = one row per USER-DAY (100,122); dim_user = one row per USER (437).
// Step goal: goal_achieved = 1 when steps >= daily_step_goal = 1.10 x the user's own average daily steps (etl/spark_etl.py); not a fixed 8,000.
// Expected values: powerbi/EXPECTED_VALUES.csv (computed independently with pandas).

// [1 Overview]  host table: fact_daily   format: #,0
Total Users = DISTINCTCOUNT ( fact_daily[user_id] )

// [1 Overview]  host table: fact_daily   format: #,0
User-Days = COUNTROWS ( fact_daily )

// [1 Overview]  host table: fact_daily   format: #,0
Total Steps = SUM ( fact_daily[steps] )

// [1 Overview]  host table: fact_daily   format: #,0
Avg Daily Steps = AVERAGE ( fact_daily[steps] )

// [1 Overview]  host table: fact_daily   format: #,0.0
Avg Calories Burned = AVERAGE ( fact_daily[calories_burned] )

// [1 Overview]  host table: fact_daily   format: #,0.0
Avg Active Minutes = AVERAGE ( fact_daily[active_minutes] )

// [1 Overview]  host table: fact_daily   format: 0.0%
Step-Goal Achievement % = DIVIDE ( SUM ( fact_daily[goal_achieved] ), COUNTROWS ( fact_daily ) )

// [1 Overview]  host table: fact_daily   format: 0.0%
Calorie-Goal Achievement % = DIVIDE ( SUM ( fact_daily[calorie_goal_achieved] ), COUNTROWS ( fact_daily ) )

// [1 Overview]  host table: fact_daily   format: #,0
Avg Steps Prev Month = CALCULATE ( [Avg Daily Steps], DATEADD ( dim_date[Date], -1, MONTH ) )

// [1 Overview]  host table: fact_daily   format: 0.0%
Steps MoM % = DIVIDE ( [Avg Daily Steps] - [Avg Steps Prev Month], [Avg Steps Prev Month] )

// [2 Activity and Sleep]  host table: fact_daily   format: 0.00
Avg Distance (km) = AVERAGE ( fact_daily[distance_km] )

// [2 Activity and Sleep]  host table: fact_daily   format: #,0.0
Avg Sedentary Minutes = AVERAGE ( fact_daily[sedentary_minutes] )

// [2 Activity and Sleep]  host table: fact_daily   format: 0.00
Avg Sleep Hours = AVERAGE ( fact_daily[sleep_hours] )

// [2 Activity and Sleep]  host table: fact_daily   format: #,0.0
Avg Sleep Quality = AVERAGE ( fact_daily[sleep_quality_score] )

// [2 Activity and Sleep]  host table: fact_daily   format: #,0.0
Avg Heart Rate = AVERAGE ( fact_daily[avg_heart_rate] )

// [2 Activity and Sleep]  host table: fact_daily   format: 0.0%
Active Share of Waking Time % = DIVIDE ( SUM ( fact_daily[active_minutes] ), SUM ( fact_daily[active_minutes] ) + SUM ( fact_daily[sedentary_minutes] ) )

// [3 Calorie Prediction]  host table: fact_daily   format: #,0.0
Avg Predicted Calories = AVERAGE ( fact_daily[predicted_calories] )

// [3 Calorie Prediction]  host table: fact_daily   format: #,0
Test Days = CALCULATE ( COUNTROWS ( fact_daily ), fact_daily[model_split] = "test" )

// [3 Calorie Prediction]  host table: fact_daily   format: #,0.0
Avg Prediction Error (bias, kcal) = CALCULATE ( AVERAGE ( fact_daily[calorie_error] ), fact_daily[model_split] = "test" )

// [3 Calorie Prediction]  host table: fact_daily   format: #,0.0
Test MAE (recomputed, kcal) = CALCULATE ( AVERAGEX ( fact_daily, ABS ( fact_daily[calorie_error] ) ), fact_daily[model_split] = "test" )

// [3 Calorie Prediction]  host table: fact_daily   format: #,0.0
Test RMSE (recomputed, kcal) = CALCULATE ( SQRT ( AVERAGEX ( fact_daily, fact_daily[calorie_error] ^ 2 ) ), fact_daily[model_split] = "test" )

// [3 Calorie Prediction]  host table: fact_daily   format: 0.0000
Test R2 (recomputed) =
    VAR T = CALCULATETABLE ( fact_daily, fact_daily[model_split] = "test" )
    VAR MeanActual = AVERAGEX ( T, fact_daily[calories_burned] )
    VAR SSE = SUMX ( T, fact_daily[calorie_error] ^ 2 )
    VAR SST = SUMX ( T, ( fact_daily[calories_burned] - MeanActual ) ^ 2 )
    RETURN 1 - DIVIDE ( SSE, SST )

// [3 Calorie Prediction]  host table: model_evaluation   format: #,0.0
Verified Test MAE (kcal) = CALCULATE ( MAX ( model_evaluation[value] ), model_evaluation[experiment_id] = "E5", model_evaluation[algorithm] = "Linear Regression (Spark MLlib)", model_evaluation[evaluation_set] = "test", model_evaluation[metric] = "MAE (kcal)" )

// [3 Calorie Prediction]  host table: model_evaluation   format: #,0.0
Verified Test RMSE (kcal) = CALCULATE ( MAX ( model_evaluation[value] ), model_evaluation[experiment_id] = "E5", model_evaluation[algorithm] = "Linear Regression (Spark MLlib)", model_evaluation[evaluation_set] = "test", model_evaluation[metric] = "RMSE (kcal)" )

// [3 Calorie Prediction]  host table: model_evaluation   format: 0.0000
Verified Test R2 = CALCULATE ( MAX ( model_evaluation[value] ), model_evaluation[experiment_id] = "E5", model_evaluation[algorithm] = "Linear Regression (Spark MLlib)", model_evaluation[evaluation_set] = "test", model_evaluation[metric] = "R2" )

// [3 Calorie Prediction]  host table: model_evaluation   format: #,0.0
Baseline Test MAE (kcal) = CALCULATE ( MAX ( model_evaluation[value] ), model_evaluation[experiment_id] = "E5", model_evaluation[algorithm] = "Training-mean baseline", model_evaluation[evaluation_set] = "test", model_evaluation[metric] = "MAE (kcal)" )

// [4 Segmentation]  host table: dim_user   format: #,0
Users in Segment = COUNTROWS ( dim_user )

// [4 Segmentation]  host table: dim_user   format: 0.0%
Segment Share % = DIVIDE ( COUNTROWS ( dim_user ), CALCULATE ( COUNTROWS ( dim_user ), ALL ( dim_user[segment_label] ) ) )

// [4 Segmentation]  host table: dim_user   format: #,0
Segment Avg Steps = AVERAGE ( dim_user[avg_steps] )

// [4 Segmentation]  host table: dim_user   format: #,0.0
Segment Avg Calories = AVERAGE ( dim_user[avg_calories] )

// [5 Model Evaluation]  host table: model_evaluation   format: 0.0000
Metric Value = MAX ( model_evaluation[value] )

// [5 Model Evaluation]  host table: confusion_matrices   format: #,0
Confusion Count = SUM ( confusion_matrices[count] )

// [5 Model Evaluation]  host table: confusion_matrices   format: 0.0%
Confusion Share of Actual = AVERAGE ( confusion_matrices[share_of_actual] )

// [5 Model Evaluation]  host table: kmeans_k_selection   format: 0.0000
K Metric Value = MAX ( kmeans_k_selection[value] )
